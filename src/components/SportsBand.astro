---
import { useSite } from '../i18n/site';
import { localePath, type Lang } from '../i18n/utils';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = useSite(lang);

/** Six headline codes for the card row. `hue` drives the placeholder wash so
 *  each card is distinguishable before photography lands. */
const cards = [
  { key: 'football', label: 'Football', hue: 146 },
  { key: 'rugby', label: 'Rugby', hue: 96 },
  { key: 'cricket', label: 'Cricket', hue: 38 },
  { key: 'tennis', label: 'Tennis', hue: 74 },
  { key: 'netball', label: 'Netball', hue: 198 },
  { key: 'hockey', label: 'Hockey', hue: 172 },
];
---

<section class="band on-dark sb">
  <span class="tex" aria-hidden="true"></span>
  <div class="shell in">
    <header class="copy reveal">
      <p class="kicker">{s('sportband.kicker')}</p>
      <h2 class="h2">
        {s('sportband.title1')}
        <br />
        <span class="alt">{s('sportband.title2')}</span>
      </h2>
      <p class="lede">{s('sportband.body')}</p>
      <a class="btn" href={localePath(lang, '/sports')}>
        {s('sportband.cta')}
        <span class="arw">
          <Icon name="arrow" />
        </span>
      </a>
    </header>

    <ul class="cards reveal">
      {cards.map((c) => (
        <li class="c" style={`--hue:${c.hue}`}>
          <a href={localePath(lang, `/sports#${c.key}`)}>
            <picture class="ph">
              <img
                src={`/img/sport-${c.key}.webp`}
                alt=""
                width="704"
                height="1024"
                loading="lazy"
                decoding="async"
              />
            </picture>
            <span class="ic">
              <Icon name="sports" />
            </span>
            <span class="lb">{c.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .sb {
    position: relative;
    overflow: clip;
  }
  .tex {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(60% 50% at 12% 30%, rgb(61 220 132 / 9%), transparent 65%),
      linear-gradient(180deg, #081311, #060f0d);
  }
  .in {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(34px, 4.4vw, 60px);
    grid-template-columns: 1fr;
    align-items: center;
  }
  @media (min-width: 1020px) {
    .in {
      grid-template-columns: 0.78fr 1.22fr;
    }
  }

  .copy .h2 {
    margin: 18px 0 20px;
  }
  .copy .lede {
    margin-bottom: 28px;
  }
  .copy .arw {
    display: inline-flex;
    width: 17px;
    height: 17px;
  }

  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 620px) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 1020px) {
    .cards {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  .c a {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4.4;
    border-radius: var(--r);
    overflow: hidden;
    text-decoration: none;
    border: 1px solid var(--line-2);
    /* Placeholder wash, per-card hue. Deliberate rather than broken-looking
             until real photography is dropped into /img. */
    background:
      linear-gradient(180deg, transparent 42%, rgb(4 12 9 / 88%) 100%),
      linear-gradient(155deg, hsl(var(--hue) 46% 26%) 0%, hsl(var(--hue) 38% 15%) 55%, #081512 100%);
    transition:
      transform 0.2s cubic-bezier(0.2, 0.7, 0.3, 1),
      border-color 0.2s ease;
  }
  .c a:hover {
    transform: translateY(-5px);
    border-color: var(--mint);
  }

  .ph {
    position: absolute;
    inset: 0;
  }
  .ph img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Keep the dark foot so the label always reads over a photo. */
  .c a::after {
    content: '';
    position: absolute;
    inset: 40% 0 0;
    background: linear-gradient(180deg, transparent, rgb(4 12 9 / 90%));
    pointer-events: none;
  }

  .ic {
    position: absolute;
    left: 50%;
    bottom: 52px;
    transform: translateX(-50%);
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    color: #fff;
    opacity: 0.92;
    z-index: 2;
  }
  .ic :global(svg) {
    width: 22px;
    height: 22px;
  }

  .lb {
    position: absolute;
    inset: auto 0 16px;
    text-align: center;
    z-index: 2;
    font-size: 13.5px;
    font-weight: 650;
    letter-spacing: -0.015em;
    color: #fff;
  }
</style>
