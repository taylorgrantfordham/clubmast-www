---
import { useTranslations, type Lang } from '../i18n/utils';
import { useSite } from '../i18n/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const s = useSite(lang);
---

<section class="cta band" id="claim">
  <span class="glow" aria-hidden="true"></span>
  <div class="shell inner reveal">
    <p class="kicker">{s('cta.kicker')}</p>
    <h2 class="display">{t('cta.title')}</h2>
    <p class="lede">{t('cta.sub')}</p>

    <form class="search" action="/search" method="get" role="search">
      <label class="vh" for="claim-q">
        {t('cta.placeholder')}
      </label>
      <input
        id="claim-q"
        name="q"
        type="search"
        placeholder={t('cta.placeholder')}
        autocomplete="off"
      />
      <button class="btn btn--lg" type="submit">
        {t('cta.button')}
      </button>
    </form>

    <p class="note">{t('hero.note')}</p>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--line);
  }
  .cta .glow {
    inset: auto -10% -50%;
    height: 620px;
  }
  .inner {
    position: relative;
    z-index: 1;
    max-width: 760px;
  }
  .display {
    margin: 18px 0 20px;
    font-size: clamp(38px, 6.6vw, 76px);
  }
  .lede {
    margin-bottom: 34px;
  }

  .search {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding: 8px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: var(--surface);
    max-width: 620px;
  }
  .search input {
    flex: 1 1 220px;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 16px;
    padding: 12px 20px;
  }
  .search input::placeholder {
    color: var(--ink-3);
  }
  .search input:focus {
    outline: none;
  }
  .search:focus-within {
    border-color: var(--accent);
  }

  @media (max-width: 520px) {
    .search {
      border-radius: var(--radius);
    }
    .search .btn {
      width: 100%;
    }
  }

  .note {
    margin-top: 20px;
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--ink-3);
  }
</style>
