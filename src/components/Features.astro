---
import { useSite } from '../i18n/site';
import type { Lang } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  intro?: string;
  exploreHref?: string;
}
const { lang, intro, exploreHref } = Astro.props;
const s = useSite(lang);

const items = [
  { icon: 'members', t: s('feat.1t'), d: s('feat.1d') },
  { icon: 'fixtures', t: s('feat.2t'), d: s('feat.2d') },
  { icon: 'message', t: s('feat.3t'), d: s('feat.3d') },
  { icon: 'payments', t: s('feat.4t'), d: s('feat.4d') },
  { icon: 'website', t: s('feat.5t'), d: s('feat.5d') },
  { icon: 'sports', t: s('feat.6t'), d: s('feat.6d') },
];
---

<section class="band on-light">
  <div class="shell grid">
    <header class="head reveal">
      <p class="kicker">{s('feat.kicker')}</p>
      <h2 class="h2">
        {s('feat.title1')}
        <br />
        {s('feat.title2')}
      </h2>
      {intro && <p class="intro">{intro}</p>}
      {exploreHref && (
        <a class="explore" href={exploreHref}>
          Explore all features &rarr;
        </a>
      )}
    </header>

    <div class="items">
      {items.map((it) => (
        <article class="item reveal">
          <span class="badge">
            <Icon name={it.icon} />
          </span>
          <h3 class="h3">{it.t}</h3>
          <p>{it.d}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: clamp(34px, 5vw, 70px);
    grid-template-columns: 1fr;
  }
  @media (min-width: 940px) {
    .grid {
      grid-template-columns: 0.85fr 2fr;
      align-items: start;
    }
  }

  .head .h2 {
    margin-top: 18px;
  }
  .intro {
    margin-top: 18px;
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.6;
    max-width: 38ch;
  }
  .explore {
    display: inline-block;
    margin-top: 18px;
    font-size: 15px;
    font-weight: 650;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 2px solid color-mix(in oklab, var(--accent) 40%, transparent);
    padding-bottom: 2px;
  }
  .explore:hover {
    border-bottom-color: var(--accent);
  }

  .items {
    display: grid;
    gap: clamp(26px, 3.4vw, 46px) clamp(24px, 3vw, 44px);
    grid-template-columns: 1fr;
  }
  @media (min-width: 620px) {
    .items {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1120px) {
    .items {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .item .badge {
    margin-bottom: 18px;
  }
  .item h3 {
    margin-bottom: 8px;
    font-weight: 750;
  }
  .item p {
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.55;
    max-width: 34ch;
  }
</style>
