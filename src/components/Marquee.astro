---
import { sports, sportName } from '../data/sports';
import type { Lang } from '../i18n/ui';
import { useSite } from '../i18n/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = useSite(lang);

// Duplicated so the CSS translate can loop seamlessly at -50%.
const names = sports.map((sp) => sportName(sp, lang));
const track = [...names, ...names];
---

<section class="mq" aria-label={s('marquee.label')}>
  <div class="rail">
    <div class="track" aria-hidden="true">
      {track.map((n) => (
        <span class="item">
          {n}
          <i class="sep">/</i>
        </span>
      ))}
    </div>
  </div>
  <p class="vh">
    {s('marquee.label')}: {names.join(', ')}
  </p>
</section>

<style>
  .mq {
    border-block: 1px solid var(--line);
    background: var(--bg-2);
    padding-block: 18px;
    overflow: hidden;
    position: relative;
  }
  /* Fade both ends so the loop never shows a hard cut. */
  .rail {
    mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent);
  }
  .track {
    display: flex;
    width: max-content;
    animation: marquee 46s linear infinite;
  }
  .item {
    display: inline-flex;
    align-items: center;
    gap: 22px;
    padding-inline-end: 22px;
    font-size: clamp(15px, 1.5vw, 19px);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .sep {
    color: var(--accent);
    font-style: normal;
    opacity: 0.55;
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
      flex-wrap: wrap;
      width: auto;
      gap: 8px;
    }
  }
</style>
