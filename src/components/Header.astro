---
import { useTranslations, localePath, type Lang } from '../i18n/utils';
import { useSite } from '../i18n/site';
import Wordmark from './Wordmark.astro';

interface Props {
  lang: Lang;
  active?: string;
}
const { lang, active } = Astro.props;
const t = useTranslations(lang);
const s = useSite(lang);

const links = [
  { key: 'home', href: localePath(lang, '/'), label: t('nav.home') },
  { key: 'product', href: localePath(lang, '/product'), label: t('nav.product') },
  { key: 'sports', href: localePath(lang, '/sports'), label: t('nav.sports') },
  // English-only microsite: never takes a locale prefix.
  { key: 'football', href: '/football', label: s('nav.football') },
  { key: 'pricing', href: localePath(lang, '/pricing'), label: t('nav.pricing') },
];
---

<header class="hd on-dark">
  <div class="shell hd-in">
    <a class="brand" href={localePath(lang, '/')} aria-label="clubmast">
      <Wordmark size={30} />
    </a>

    <nav class="nav" aria-label="Primary">
      {links.map((l) => (
        <a
          href={l.href}
          class={active === l.key ? 'on' : ''}
          aria-current={active === l.key ? 'page' : undefined}
        >
          {l.label}
        </a>
      ))}
    </nav>

    <div class="right">
      <a class="login" href={localePath(lang, '/#claim')}>
        {s('nav.login')}
      </a>
      <a class="btn" href={localePath(lang, '/#claim')}>
        {s('nav.start')}
      </a>
    </div>
  </div>
</header>

<style>
  .hd {
    position: sticky;
    top: 0;
    z-index: 60;
    background: color-mix(in oklab, var(--night) 88%, transparent);
    backdrop-filter: blur(16px) saturate(1.3);
  }
  .hd-in {
    display: flex;
    align-items: center;
    gap: 14px 32px;
    padding-block: 16px;
  }
  .brand {
    text-decoration: none;
    display: inline-flex;
  }

  .nav {
    display: none;
    gap: 30px;
    margin-inline: auto;
  }
  .nav a {
    position: relative;
    font-size: 15px;
    font-weight: 550;
    color: var(--ink-2);
    text-decoration: none;
    padding-block: 6px;
    transition: color 0.15s ease;
  }
  .nav a:hover {
    color: var(--ink);
  }
  /* Underline on the current page, as in the reference. */
  .nav a.on {
    color: var(--ink);
    font-weight: 650;
  }
  .nav a.on::after {
    content: '';
    position: absolute;
    inset: auto 0 -2px;
    height: 2.5px;
    border-radius: 2px;
    background: var(--mint);
  }

  .right {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-inline-start: auto;
  }
  .login {
    font-size: 15px;
    font-weight: 550;
    color: var(--ink-2);
    text-decoration: none;
    padding: 10px 6px;
  }
  .login:hover {
    color: var(--ink);
  }
  .btn {
    padding: 12px 22px;
    font-size: 14.5px;
  }

  @media (min-width: 1000px) {
    .nav {
      display: flex;
    }
    .right {
      margin-inline-start: 0;
    }
  }
  @media (max-width: 560px) {
    .login {
      display: none;
    }
  }
</style>
