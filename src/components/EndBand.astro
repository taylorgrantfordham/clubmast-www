---
import { useSite } from '../i18n/site';
import { localePath, type Lang } from '../i18n/utils';
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = useSite(lang);

const stats = [
  { v: s('end.s1'), l: s('end.s1l') },
  { v: s('end.s2'), l: s('end.s2l') },
  { v: s('end.s3'), l: s('end.s3l') },
];
---

<section class="band on-light end" id="claim">
  <div class="shell in">
    <div class="brand reveal">
      <Wordmark size={40} />
      <p class="tag">{s('end.tagline')}</p>
    </div>

    <dl class="stats reveal">
      {stats.map((st) => (
        <div>
          <dt>{st.v}</dt>
          <dd>{st.l}</dd>
        </div>
      ))}
    </dl>

    <div class="cta reveal">
      <p class="kicker">{s('end.kicker')}</p>
      <h2 class="h3 big">{s('end.title')}</h2>
      <a class="btn" href={localePath(lang, '/pricing')}>
        {s('hero.primary')}
        <span class="arw">
          <Icon name="arrow" />
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .end {
    padding-block: clamp(46px, 5.5vw, 78px);
  }
  .in {
    display: grid;
    gap: clamp(30px, 4vw, 48px);
    grid-template-columns: 1fr;
    align-items: center;
  }
  @media (min-width: 900px) {
    .in {
      grid-template-columns: 1fr 1.15fr 0.9fr;
    }
  }

  .tag {
    margin-top: 16px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    line-height: 1.7;
    max-width: 26ch;
  }

  .stats {
    display: grid;
    gap: 24px 36px;
    margin: 0;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
  }
  @media (min-width: 900px) {
    .stats {
      justify-content: center;
      border-inline: 1px solid var(--line);
      padding-inline: clamp(24px, 3vw, 46px);
    }
  }
  .stats div {
    display: grid;
    gap: 4px;
  }
  .stats dt {
    font-size: clamp(24px, 2.7vw, 34px);
    font-weight: 800;
    letter-spacing: -0.045em;
    font-variant-numeric: tabular-nums;
  }
  .stats dd {
    margin: 0;
    font-size: 13px;
    color: var(--ink-3);
  }

  .cta .big {
    font-size: clamp(21px, 2.3vw, 27px);
    margin: 12px 0 20px;
    max-width: 16ch;
    font-weight: 800;
  }
  .cta .arw {
    display: inline-flex;
    width: 17px;
    height: 17px;
  }
</style>
