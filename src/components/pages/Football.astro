---
import Cta from '../Cta.astro';
import Mockup from '../Mockup.astro';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

/**
 * The football microsite hub.
 *
 * A subfolder rather than a subdomain: a subfolder inherits the root domain's
 * authority, so every link cricket or netball earns later lifts this page too.
 * A subdomain would have to start from nothing.
 */

const buyers = [
  {
    t: 'Junior and youth clubs',
    d: 'Fifteen to twenty-five teams, three hundred players, one treasurer trying to reconcile subs against a bank statement.',
    p: [
      'Subs by Direct Debit with sibling caps',
      'Match fees charged on selection',
      'Registration and age banding',
      'DBS and safeguarding in one register',
    ],
  },
  {
    t: 'Non-league and semi-pro',
    d: 'A gate, a bar, a programme, a 200 club and a junior section — currently run across four systems and a spreadsheet.',
    p: [
      'Tickets and season tickets with QR entry',
      'Matchday programme and club shop',
      'Sponsor packages that renew themselves',
      'Live match centre and streaming',
    ],
  },
  {
    t: 'Sunday and Saturday league',
    d: 'One team, no budget, and a manager who just wants the fees in and the fixtures right.',
    p: [
      'Free site on your own domain',
      'Availability without a WhatsApp poll',
      'Match fees collected automatically',
      'Fixtures straight from the league',
    ],
  },
  {
    t: 'Leagues and county FAs',
    d: 'Twenty to a hundred clubs, one secretary, and a results inbox that fills up every Saturday at five.',
    p: [
      'Fixture generation with clash detection',
      'Results, tables and discipline',
      'Registration approval and transfers',
      'Every member club gets a free site',
    ],
  },
];

const jobs = [
  {
    t: 'Club website',
    d: 'Your own domain, fixtures and results updating themselves, and a page that loads before the thumb lifts.',
  },
  {
    t: 'Subs collection',
    d: 'Direct Debit, instalments, family discounts and hardship cases — with dunning that chases so nobody has to.',
  },
  {
    t: 'Match fees',
    d: 'Charged the moment a player is selected. The worst job in the club, done without anyone doing it.',
  },
  {
    t: 'Availability',
    d: 'Asked, reminded and escalated automatically, with a no-show warning on Thursday instead of a panic on Saturday.',
  },
  {
    t: 'Fixtures and results',
    d: 'Imported from your league, published to the site, and submitted back after the whistle.',
  },
  {
    t: 'Match reports',
    d: 'Written from the team sheet and the score, published to the site and socials minutes after full time.',
  },
  {
    t: 'Safeguarding',
    d: 'DBS status, coaching badges, first aid and photo consent tracked, with warnings long before anything expires.',
  },
  {
    t: 'Tournaments',
    d: 'Entries, groups, pitches, referees and results — for the summer festival that funds half your season.',
  },
];
---

<section class="hero">
  <span class="glow" aria-hidden="true"></span>
  <span class="grid-lines" aria-hidden="true"></span>

  <div class="shell hero-in">
    <p class="kicker">Football · 40,000 UK clubs</p>
    <h1 class="display">The whole football club, in one place.</h1>
    <p class="lede">
      Subs, match fees, availability, fixtures, safeguarding and a website that actually loads. Free
      for every club — from a Sunday league side to a National League ground.
    </p>

    <div class="acts">
      <a class="btn btn--lg" href="#claim">
        Claim your club
      </a>
      <a class="btn btn--ghost btn--lg" href="#jobs">
        What it does
      </a>
    </div>

    <div class="import card card--lit">
      <p class="il">Start here</p>
      <p class="ib">Paste your FA Full-Time league address.</p>
      <p class="is">
        Ninety seconds later your club has a site with every fixture, result, table and squad
        already on it. Nobody types two hundred fixtures.
      </p>
    </div>
  </div>

  <div class="shell shot">
    <Mockup />
  </div>
</section>

<!-- ------------------------------------------------------------- buyers -->
<section class="band alt">
  <div class="shell">
    <header class="sec reveal">
      <p class="kicker">Who it is for</p>
      <h2 class="h2">Four very different football clubs</h2>
      <p class="lede">
        A junior committee and a National League board have almost nothing in common except the
        sport. The platform meets both without either using the other's product.
      </p>
    </header>

    <div class="buyers">
      {buyers.map((b) => (
        <article class="card reveal">
          <h3 class="h3">{b.t}</h3>
          <p class="bd">{b.d}</p>
          <ul>
            {b.p.map((x) => (
              <li>
                <span class="tick" aria-hidden="true">
                  &check;
                </span>
                {x}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- --------------------------------------------------------------- jobs -->
<section class="band" id="jobs">
  <div class="shell">
    <header class="sec reveal">
      <p class="kicker">The jobs</p>
      <h2 class="h2">Everything the committee currently does by hand</h2>
    </header>

    <div class="jobs reveal">
      {jobs.map((j, i) => (
        <article class="job">
          <span class="jn">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="jt">{j.t}</h3>
            <p>{j.d}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ------------------------------------------------------------- switch -->
<section class="band alt">
  <div class="shell switch reveal">
    <div>
      <p class="kicker">Switching</p>
      <h2 class="h2">Already on Pitchero or a WordPress site?</h2>
      <p class="lede">
        Keep it running as long as you like. Claim your club, put the two side by side, and point
        your domain when you are ready. Your fixtures come straight from the league either way, and
        nothing is locked in — export everything whenever you want.
      </p>
      <a class="btn" href="#claim">
        Claim your club
      </a>
    </div>
    <dl class="facts">
      <div>
        <dt>£0</dt>
        <dd>for the website, permanently</dd>
      </div>
      <div>
        <dt>90s</dt>
        <dd>from league address to live site</dd>
      </div>
      <div>
        <dt>&lt;50ms</dt>
        <dd>served from the edge</dd>
      </div>
    </dl>
  </div>
</section>

<Cta lang={lang} />

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-top: clamp(44px, 7vw, 92px);
  }
  .hero-in {
    position: relative;
    z-index: 1;
  }
  .hero .display {
    margin: 20px 0 22px;
    max-width: 14ch;
  }
  .hero .lede {
    margin-bottom: 30px;
  }
  .acts {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .import {
    margin-top: clamp(34px, 4vw, 52px);
    max-width: 620px;
  }
  .il {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 12px;
  }
  .ib {
    font-size: clamp(19px, 2.2vw, 25px);
    font-weight: 750;
    letter-spacing: -0.032em;
    line-height: 1.2;
  }
  .is {
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.5;
    margin-top: 12px;
    max-width: 52ch;
  }

  .shot {
    position: relative;
    z-index: 1;
    margin-top: clamp(40px, 5vw, 72px);
  }

  .band.alt {
    background: var(--bg-2);
    border-block: 1px solid var(--line);
  }
  .sec {
    max-width: 58ch;
    margin-bottom: clamp(28px, 3.6vw, 50px);
  }
  .sec .h2 {
    margin: 16px 0 14px;
  }

  .buyers {
    display: grid;
    gap: var(--gap);
    grid-template-columns: 1fr;
  }
  @media (min-width: 820px) {
    .buyers {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .bd {
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.5;
    margin: 12px 0 18px;
  }
  .buyers ul,
  .card ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 9px;
  }
  .buyers li {
    display: grid;
    grid-template-columns: 16px 1fr;
    gap: 10px;
    align-items: start;
    font-size: 14px;
    line-height: 1.4;
    color: var(--ink-2);
  }
  .tick {
    color: var(--accent);
    font-weight: 700;
    font-size: 12px;
    line-height: 1.5;
  }

  .jobs {
    display: grid;
    gap: 0;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 880px) {
    .jobs {
      grid-template-columns: 1fr 1fr;
      column-gap: 44px;
    }
  }
  .job {
    display: grid;
    grid-template-columns: 38px 1fr;
    gap: 14px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
    align-items: start;
  }
  .jn {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--accent);
    padding-top: 4px;
  }
  .jt {
    font-size: 17.5px;
    font-weight: 700;
    letter-spacing: -0.028em;
    margin-bottom: 7px;
  }
  .job p {
    color: var(--ink-2);
    font-size: 14.5px;
    line-height: 1.5;
    max-width: 46ch;
  }

  .switch {
    display: grid;
    gap: clamp(30px, 4vw, 56px);
    grid-template-columns: 1fr;
    align-items: center;
  }
  @media (min-width: 900px) {
    .switch {
      grid-template-columns: 1.3fr 0.7fr;
    }
  }
  .switch .h2 {
    margin: 16px 0 16px;
    max-width: 16ch;
  }
  .switch .btn {
    margin-top: 26px;
  }
  .facts {
    display: grid;
    gap: 20px;
    margin: 0;
  }
  .facts div {
    border-top: 1px solid var(--line-2);
    padding-top: 14px;
  }
  .facts dt {
    font-size: clamp(30px, 3.6vw, 44px);
    font-weight: 800;
    letter-spacing: -0.05em;
  }
  .facts dd {
    margin: 4px 0 0;
    color: var(--ink-3);
    font-size: 13.5px;
  }
</style>
