---
import { useTranslations, localePath, type Lang } from '../../i18n/utils';
import { useSite } from '../../i18n/site';
import { sports, sportName } from '../../data/sports';
import Cta from '../Cta.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const s = useSite(lang);

/** Verticals beyond the headline sixteen. English names — these are the long
 *  tail, and a name nobody searches for does not earn a translation yet. */
const longTail = [
  'Rugby league',
  'Basketball',
  'Squash',
  'Table tennis',
  'Pickleball',
  'Volleyball',
  'Pool',
  'Boxing',
  'Judo',
  'Karate',
  'Gymnastics',
  'Cheerleading',
  'Fencing',
  'Archery',
  'Cycling',
  'Triathlon',
  'Canoeing',
  'Equestrian',
  'Chess',
  'Bridge',
];
---

<section class="head band">
  <span class="glow" aria-hidden="true"></span>
  <div class="shell inner">
    <p class="kicker">{s('sports.kicker')}</p>
    <h1 class="display">{t('sports.title')}</h1>
    <p class="lede">{t('sports.sub')}</p>
  </div>
</section>

<section class="band">
  <div class="shell">
    <div class="grid">
      {sports.map((sp) => (
        <article class="sp reveal" id={sp.key}>
          <div class="top">
            <h2 class="h3">{sportName(sp, lang)}</h2>
            <span class="cnt">{sp.clubs}</span>
          </div>
          <p class="cl">UK clubs</p>
          {sp.key === 'football' && (
            <a class="more" href={localePath(lang, '/football')}>
              {s('nav.football')} &rarr;
            </a>
          )}
        </article>
      ))}
    </div>

    <div class="tail reveal">
      <h2 class="h3">{t('sports.more')}</h2>
      <ul>
        {longTail.map((n) => (
          <li>{n}</li>
        ))}
      </ul>
      <p class="note">
        Every one of these runs on the same twelve engines. A new code is a configuration file, not
        a new product — which is why the list keeps growing.
      </p>
    </div>
  </div>
</section>

<Cta lang={lang} />

<style>
  .head {
    position: relative;
    overflow: clip;
    padding-bottom: clamp(24px, 3vw, 40px);
  }
  .inner {
    position: relative;
    z-index: 1;
  }
  .head .display {
    margin: 20px 0 22px;
    max-width: 14ch;
  }

  .grid {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
  }
  .sp {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 20px;
    scroll-margin-top: 90px;
    transition:
      border-color 0.16s ease,
      transform 0.16s ease;
  }
  .sp:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }
  .cnt {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .cl {
    font-size: 12px;
    color: var(--ink-3);
    margin-top: 4px;
  }
  .more {
    display: inline-block;
    margin-top: 14px;
    font-size: 13px;
    font-weight: 650;
    color: var(--accent);
    text-decoration: none;
  }
  .more:hover {
    text-decoration: underline;
  }

  .tail {
    margin-top: clamp(40px, 5vw, 70px);
    padding: clamp(24px, 3vw, 38px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-2);
  }
  .tail ul {
    list-style: none;
    margin: 20px 0 18px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tail li {
    font-size: 13.5px;
    color: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 7px 14px;
    background: var(--surface);
  }
  .note {
    color: var(--ink-3);
    font-size: 14.5px;
    max-width: 58ch;
    line-height: 1.5;
  }
</style>
