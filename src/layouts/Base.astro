---
import '../styles/tokens.css';
import { languages, alternates, type Lang } from '../i18n/utils';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Canonical page path without locale prefix, e.g. "/" or "/sports" */
  path?: string;
  /** Nav key to mark as current. */
  active?: string;
}

const { lang, title, description, path = '/', active } = Astro.props;
const meta = languages[lang];
const site = Astro.site ?? new URL('https://clubmast.com');
const alts = alternates(path);
const canonical = new URL(alts.find((a) => a.code === lang)!.href, site).href;
---

<!doctype html>
<html lang={meta.tag} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {alts.map((a) => (
      <link rel="alternate" hreflang={a.tag} href={new URL(a.href, site).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL('/', site).href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Clubmast" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={meta.tag.replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#f7f9f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#07100c" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400..800&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=IBM+Plex+Mono:wght@400;500;600&family=Caveat:wght@600;700&display=swap"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'Clubmast',
        applicationCategory: 'BusinessApplication',
        operatingSystem: 'Web',
        description,
        url: site.href,
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'GBP' },
      })}
    ></script>
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <Header lang={lang} active={active} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} path={path} />
  </body>
</html>
