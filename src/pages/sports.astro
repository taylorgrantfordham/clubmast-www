---
import Base from '../layouts/Base.astro';
import Sports from '../components/pages/Sports.astro';
import { useTranslations, defaultLang } from '../i18n/utils';

const lang = defaultLang;
const t = useTranslations(lang);
---

<Base
  lang={lang}
  title={`${t('nav.sports')} — Clubmast`}
  description={t('meta.home.desc')}
  path="/sports"
  active="sports"
>
  <Sports lang={lang} />
</Base>
