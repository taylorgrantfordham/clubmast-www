---
import Base from '../../layouts/Base.astro';
import Product from '../../components/pages/Product.astro';
import { useTranslations, codes, defaultLang, type Lang } from '../../i18n/utils';

export function getStaticPaths() {
  return codes.filter((c) => c !== defaultLang).map((c) => ({ params: { lang: c } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<Base
  lang={lang}
  title={`${t('nav.product')} — Clubmast`}
  description={t('meta.home.desc')}
  path="/product"
  active="product"
>
  <Product lang={lang} />
</Base>
