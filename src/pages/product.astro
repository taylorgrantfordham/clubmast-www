---
import Base from '../layouts/Base.astro';
import Product from '../components/pages/Product.astro';
import { useTranslations, defaultLang } from '../i18n/utils';

const lang = defaultLang;
const t = useTranslations(lang);
---

<Base
  lang={lang}
  title={`${t('nav.product')} — Clubmast`}
  description={t('meta.home.desc')}
  path="/product"
  active="product"
>
  <Product lang={lang} />
</Base>
